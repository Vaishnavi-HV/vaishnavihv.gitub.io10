/* Google Font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap');

/* Body Background */
body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
}

/* Center Card */
.container {
    display: flex;
    justify-content: center;
    align-items: center;
}

/* Card Design */
.card {
    border: none;
    border-radius: 15px;
    padding: 20px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

/* Heading */
h3 {
    font-weight: 600;
    color: #333;
}

/* Input Fields */
.form-control {
    border-radius: 10px;
    padding: 10px;
    border: 1px solid #ccc;
    transition: 0.3s;
}

.form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 8px rgba(102, 126, 234, 0.5);
}

/* Labels */
.form-label {
    font-weight: 500;
}

/* Button */
.btn-primary {
    background-color: #667eea;
    border: none;
    border-radius: 10px;
    padding: 10px;
    transition: 0.3s;
}

.btn-primary:hover {
    background-color: #5a67d8;
    transform: scale(1.05);
}

/* Links */
a {
    color: #667eea;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

/* Password Toggle Icon */
.password-toggle {
    position: absolute;
    right: 15px;
    top: 38px;
    cursor: pointer;
    color: #888;
}

/* Responsive */
@media (max-width: 768px) {
    .card {
        margin: 20px;
    }
}
